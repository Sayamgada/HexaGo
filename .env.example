# LLM & AI Configuration (agents-py)
# gemini-2.x and text-embedding-004 answer 404 (retired). Checked live on 2026-11-18.
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Tried in order after LLM_MODEL: a 404 drops a model, a 429/503 backs off and moves on.
LLM_FALLBACK_MODELS=gemini/gemini-3.1-flash-lite,gemini/gemini-3-flash-preview
GEMINI_API_KEY=your-gemini-api-key-here
EMBEDDING_MODEL=gemini/gemini-embedding-001

# LLM cost guardrails (agents-py)
LLM_ENABLED=true
# Per provider attempt; flash-lite models answer a short JSON prompt in ~1-1.6 s.
LLM_TIMEOUT_S=4
# First wait after a 429/503 before the next model; doubles, capped at 8 s.
LLM_BACKOFF_S=0.5
LLM_DAILY_CALL_LIMIT=300
LLM_DAILY_TOKEN_LIMIT=200000
LLM_MIN_INTERVAL_S=20
LLM_CACHE_TTL_S=600
# Ops Supervisor heartbeat period in seconds; 0 disables it.
HEARTBEAT_INTERVAL_S=300

# Databases & Infrastructure
DATABASE_URL=postgres://hexago:hexago@localhost:5432/hexago?sslmode=disable
# Local: redis://. On Render use the Key Value *External* URL (rediss://...:6379, TLS)
# and allow the service in its inbound IP rules. Check it with GET /healthz?redis=fresh
# on either service (live connect / PING / pub-sub, masked URL, failing stage, hint).
REDIS_URL=redis://localhost:6379/0

# Microservice Interconnect
# dispatch-go -> agents-py, and agents-py -> dispatch-go
AGENTS_URL=http://localhost:8000
DISPATCH_URL=http://localhost:8080
PORT=8080
AGENTS_PORT=8000

# Geographic & Demo Settings (Bengaluru, India)
DEMO_MODE=true
CITY_CENTER_LAT=12.9716
CITY_CENTER_LNG=77.5946

# CORS: comma-separated origins; ":*" allows any port on that host
CORS_ALLOWED_ORIGINS=https://hexago-web.onrender.com,http://localhost:*,http://127.0.0.1:*


# Dispatch & simulator
MAX_PICKUP_KM=5
# auto = sized to SIM_DRIVERS for ~50% busy drivers
SIM_DEMAND_PER_MIN=auto
